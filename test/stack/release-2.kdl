system {
    worker-threads 1
}

listeners {
    listener "http" {
        address "0.0.0.0:8080"
        protocol "http"
    }
}

routes {
    route "health" {
        priority "high"
        matches {
            path "/health"
        }
        builtin-handler "health"
    }

    route "release-2" {
        priority "high"
        matches {
            path "/release-2"
        }
        builtin-handler "status"
    }
}
