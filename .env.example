# Copy to .env and fill in. Never commit .env.

# Generate each of these with the command shown. Keep them stable: changing
# ENCRYPTION_KEY without rotating (see docs/DEPLOYMENT.md) makes secrets unreadable.
SECRET_KEY_BASE=           # openssl rand -base64 48
ENCRYPTION_KEY=            # openssl rand -base64 32
POSTGRES_PASSWORD=         # openssl rand -hex 24
MINIO_ROOT_USER=zentinel
MINIO_ROOT_PASSWORD=       # openssl rand -hex 24

# Creates the first admin on first boot only. Remove once you have signed in.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# PHX_HOST=cp.example.com
# FORCE_SSL=true
# TRUSTED_PROXY_COUNT=1
# METRICS_TOKEN=           # openssl rand -hex 32
# GITHUB_WEBHOOK_SECRET=
